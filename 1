local function destroyFreeCamGui()
    if guiGuardConn then guiGuardConn:Disconnect() guiGuardConn = nil end
    if freeCamGui then pcall(function() freeCamGui:Destroy() end) freeCamGui = nil end
    pcall(function()
        local a = CoreGui:FindFirstChild("FreeCamControls")
        if a then a:Destroy() end
    end)
    pcall(function()
        local b = LocalPlayer:FindFirstChild("PlayerGui")
        if b then
            local c = b:FindFirstChild("FreeCamControls")
            if c then c:Destroy() end
        end
    end)
    freeCamBtns = {}
    for k in pairs(moveState) do moveState[k] = false end
end

local function stopFreeCam()
    if touchStartedConn then touchStartedConn:Disconnect() touchStartedConn = nil end
    if touchMovedConn then touchMovedConn:Disconnect() touchMovedConn = nil end
    if touchEndedConn then touchEndedConn:Disconnect() touchEndedConn = nil end
    if freeCamConnection then freeCamConnection:Disconnect() freeCamConnection = nil end
    local camera = workspace.CurrentCamera
    if freeCamOriginalType then
        camera.CameraType = freeCamOriginalType
        freeCamOriginalType = nil
    end
    destroyFreeCamGui()
    freeCam = false
end

local function startFreeCam()
    local camera = workspace.CurrentCamera
    freeCamOriginalType = camera.CameraType
    camera.CameraType = Enum.CameraType.Scriptable
    freeCamPos = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    freeCamRotY = math.deg(math.atan2(-look.X, -look.Z))
    freeCamRotX = math.deg(math.asin(math.clamp(look.Y, -1, 1)))

    createFreeCamGui()

    guiGuardConn = RunService.Heartbeat:Connect(function()
        if freeCam and (not freeCamGui or not freeCamGui.Parent) then
            createFreeCamGui()
        end
    end)

    local lastTouchPos = nil
    touchStartedConn = UserInputService.TouchStarted:Connect(function(input, gpe)
        if gpe then return end
        lastTouchPos = input.Position
    end)
    touchMovedConn = UserInputService.TouchMoved:Connect(function(input, gpe)
        if gpe then return end
        if lastTouchPos then
            local delta = input.Position - lastTouchPos
            lastTouchPos = input.Position
            freeCamRotY = freeCamRotY - delta.X * 0.4
            freeCamRotX = math.clamp(freeCamRotX - delta.Y * 0.4, -89, 89)
        end
    end)
    touchEndedConn = UserInputService.TouchEnded:Connect(function()
        lastTouchPos = nil
    end)

    local speed = 1.2
    freeCamConnection = RunService.RenderStepped:Connect(function(dt)
        local move = Vector3.zero
        if moveState.f then move = move + Vector3.new(0,0,-1) end
        if moveState.b then move = move + Vector3.new(0,0,1) end
        if moveState.l then move = move + Vector3.new(-1,0,0) end
        if moveState.r then move = move + Vector3.new(1,0,0) end
        if moveState.u then move = move + Vector3.new(0,1,0) end
        if moveState.d then move = move + Vector3.new(0,-1,0) end

        local rot = CFrame.fromEulerAnglesYXZ(math.rad(freeCamRotX), math.rad(freeCamRotY), 0)
        local worldMove = rot:VectorToWorldSpace(move)
        if worldMove.Magnitude > 1 then worldMove = worldMove.Unit end
        freeCamPos = freeCamPos + worldMove * speed * 40 * dt
        camera.CFrame = CFrame.new(freeCamPos) * rot
    end)
    freeCam = true
end

-- ===== 反转镜头 =====
local function stopFlipCam()
    if flipConnection then flipConnection:Disconnect() flipConnection = nil end
    local camera = workspace.CurrentCamera
    if originalCameraType then camera.CameraType = originalCameraType originalCameraType = nil end
end

local function startFlipCam()
    local camera = workspace.CurrentCamera
    if not originalCameraType then originalCameraType = camera.CameraType end
    camera.CameraType = Enum.CameraType.Scriptable
    flipConnection = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local lookDir = hrp.CFrame.LookVector
        local camPos = hrp.Position + lookDir * 12 + Vector3.new(0, 4, 0)
        camera.CFrame = CFrame.new(camPos, hrp.Position - lookDir * 20)
    end)
end

-- ===== 强制第三人称（重写：无视游戏第一人称锁定） =====
local function stopForceThird()
    if thirdConnection then thirdConnection:Disconnect() thirdConnection = nil end
    if thirdTouchConn then thirdTouchConn:Disconnect() thirdTouchConn = nil end
    if thirdTouchMovedConn then thirdTouchMovedConn:Disconnect() thirdTouchMovedConn = nil end
    
    local camera = workspace.CurrentCamera
    if thirdOriginalType then 
        camera.CameraType = thirdOriginalType 
        thirdOriginalType = nil 
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then 
        pcall(function() 
            hum.CameraOffset = Vector3.zero 
            hum.CameraMode = Enum.CameraMode.Classic
        end) 
    end
    pcall(function() LocalPlayer.CameraMode = Enum.CameraMode.Classic end)
end

local function startForceThird()
    local camera = workspace.CurrentCamera
    thirdOriginalType = camera.CameraType
    
    -- 强行接管相机
    pcall(function() LocalPlayer.CameraMode = Enum.CameraMode.Classic end)
    camera.CameraType = Enum.CameraType.Scriptable
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.CameraMode = Enum.CameraMode.Classic end)
    end

    thirdCameraAngleX = 15
    thirdCameraAngleY = 0

    -- 手机触摸转视角
    local lastTouchPos = nil
    thirdTouchConn = UserInputService.TouchStarted:Connect(function(input, gpe)
        if gpe then return end
        lastTouchPos = input.Position
    end)
    thirdTouchMovedConn = UserInputService.TouchMoved:Connect(function(input, gpe)
        if gpe then return end
        if lastTouchPos then
            local delta = input.Position - lastTouchPos
            lastTouchPos = input.Position
            thirdCameraAngleY = thirdCameraAngleY - delta.X * 0.4
            thirdCameraAngleX = math.clamp(thirdCameraAngleX - delta.Y * 0.4, -20, 80)
        end
    end)
    UserInputService.TouchEnded:Connect(function()
        lastTouchPos = nil
    end)

    -- 自己计算第三人称位置（带防穿墙射线）
    thirdConnection = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if cam.CameraType ~= Enum.CameraType.Scriptable then
            cam.CameraType = Enum.CameraType.Scriptable
        end
        
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local hrp = myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if not hrp or not myHum or myHum.Health <= 0 then return end

        -- 计算理想的相机位置
        local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
        local rot = CFrame.fromEulerAnglesYXZ(math.rad(thirdCameraAngleX), math.rad(thirdCameraAngleY), 0)
        local offset = rot:VectorToWorldSpace(Vector3.new(0, 0, 12))
        local targetPos = headPos + offset

        -- 防穿墙检测
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {myChar}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        local rayResult = workspace:Raycast(headPos, offset, raycastParams)
        
        if rayResult then
            -- 如果被墙挡住，相机拉到墙前面
            targetPos = rayResult.Position
        end

        -- 设置相机
        cam.CFrame = CFrame.new(targetPos, headPos)
    end)
end

